# /etc/certwarden-to-nginx-sync/env   (chmod 600, owned by root)
# Plain KEY=VALUE lines. The file is read as text, never executed by a shell,
# so special characters in passwords need no escaping. Quotes are optional.
#
# For each target NAME in targets.toml (upper-cased, non-alphanumerics as _):

# NPM user for the script. NPM identifies users by e-mail address. Give it only the
# "certificates: manage" permission; it does not need to be an admin.
NPM_MAIN_USER=certwarden@example.lan
NPM_MAIN_PASS=<password>

# Cert Warden API keys: one for the certificate, one for its private key.
CW_MAIN_CERT_APIKEY=<certificate-api-key>
CW_MAIN_KEY_APIKEY=<private-key-api-key>

# Same again for the second target in the example config.
NPM_LAB_USER=certwarden@example.lan
NPM_LAB_PASS=<password>
CW_LAB_CERT_APIKEY=<certificate-api-key>
CW_LAB_KEY_APIKEY=<private-key-api-key>

# nginx-ssh targets need only the Cert Warden API keys (SSH uses the ssh_key file from
# targets.toml, not a password), here for the target named "web".
CW_WEB_CERT_APIKEY=<certificate-api-key>
CW_WEB_KEY_APIKEY=<private-key-api-key>
