#!/usr/bin/env python3
"""Push Cert Warden certificates to Nginx Proxy Manager (NPM) and to plain nginx hosts.

For each target in the config file: download fullchain + key from Cert Warden, then
  type = "npm" (default): create the NPM custom certificate on the first run, or upload
      over the same certificate id on later runs, so proxy hosts that use it keep
      working. Proxy hosts are never touched.
  type = "nginx-ssh": over SSH, write the certificate and key files on each listed host,
      run the nginx config test, then reload nginx. If the test or reload fails, the
      previous files are put back.
Unchanged certificates are skipped (state is kept per target, and per host for SSH).

Non-secret settings live in a TOML config file (see examples/targets.example.toml).
Secrets live in an env file, read as plain KEY=VALUE text and never executed by a
shell (see examples/env.example). Nothing secret is printed.

Usage: certwarden-to-nginx-sync [--only NAME] [--force] [--dry-run]
                           [--config FILE] [--env FILE] [--state-dir DIR]
"""
import argparse
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tomllib
import urllib.error
import urllib.request
import uuid

DEFAULT_CONFIG = "/etc/certwarden-to-nginx-sync/targets.toml"
DEFAULT_ENV = "/etc/certwarden-to-nginx-sync/env"
DEFAULT_STATE_DIR = "/var/lib/certwarden-to-nginx-sync"
KEY_RE = re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.S)


def log(msg):
    print(msg, flush=True)


def load_env(path):
    env = {}
    with open(path) as fh:
        for line in fh:
            line = line.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                v = v[1:-1]
            env[k.strip()] = v
    return env


def http(method, url, headers=None, body=None, timeout=30):
    req = urllib.request.Request(url, data=body, method=method, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()


def http_json(method, url, token=None, payload=None):
    headers = {"Content-Type": "application/json"}
    if token:
        headers["Authorization"] = "Bearer " + token
    body = json.dumps(payload).encode() if payload is not None else None
    code, raw = http(method, url, headers, body)
    try:
        return code, json.loads(raw)
    except ValueError:
        return code, {}


def multipart(fields):
    boundary = uuid.uuid4().hex
    parts = []
    for name, value in fields.items():
        parts.append(
            f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"; filename="{name}.pem"\r\n'
            f"Content-Type: application/x-pem-file\r\n\r\n{value}\r\n"
        )
    parts.append(f"--{boundary}--\r\n")
    return "".join(parts).encode(), f"multipart/form-data; boundary={boundary}"


def prefix_of(target):
    """Env variable prefix for a target: its own env_prefix, else the upper-cased name."""
    return target.get("env_prefix") or re.sub(r"[^A-Za-z0-9]", "_", target["name"]).upper()


def fetch_cert_and_key(cw_url, cw_cert, cert_apikey, key_apikey):
    base = cw_url.rstrip("/") + "/certwarden/api/v1/download"
    code, raw = http("GET", f"{base}/certificates/{cw_cert}", {"X-API-Key": cert_apikey})
    if code != 200:
        raise RuntimeError(f"Cert Warden certificate download failed (HTTP {code})")
    fullchain = raw.decode()
    code, raw = http("GET", f"{base}/privatecerts/{cw_cert}", {"X-API-Key": f"{cert_apikey}.{key_apikey}"})
    if code != 200:
        raise RuntimeError(f"Cert Warden key download failed (HTTP {code})")
    m = KEY_RE.search(raw.decode())
    if not m:
        raise RuntimeError("no private key found in Cert Warden response")
    if "BEGIN CERTIFICATE" not in fullchain:
        raise RuntimeError("certificate response is not PEM")
    return fullchain, m.group(0) + "\n"


def read_state(state_dir, name):
    path = os.path.join(state_dir, f"{name}.sha256")
    return path, (open(path).read().strip() if os.path.exists(path) else "")


def write_state(path, state_dir, digest):
    os.makedirs(state_dir, mode=0o700, exist_ok=True)
    with open(path, "w") as fh:
        fh.write(digest + "\n")


SSH_DEFAULTS = {"test_cmd": "nginx -t", "reload_cmd": "nginx -s reload"}
SSH_KEYS = ("ssh_user", "ssh_port", "ssh_key", "cert_path", "key_path", "test_cmd", "reload_cmd")


def ssh_hosts(target):
    """Normalise the hosts of an nginx-ssh target: each is a string or a table, and
    target-level settings are the defaults for every host."""
    defaults = dict(SSH_DEFAULTS)
    defaults.update({k: target[k] for k in SSH_KEYS if k in target})
    out = []
    for h in target.get("hosts", []):
        d = dict(defaults)
        d.update({"host": h} if isinstance(h, str) else h)
        for req in ("host", "cert_path", "key_path"):
            if not d.get(req):
                raise RuntimeError(f"a host entry is missing {req}")
        out.append(d)
    if not out:
        raise RuntimeError("no hosts listed")
    return out


def remote_script(h, fullchain, key):
    """Shell script run on the host (`sh -s`, fed on stdin, so the key never appears in a
    command line). Writes new files next to the old ones, swaps them in, tests and
    reloads nginx, and restores the old files if that fails."""
    if not fullchain.endswith("\n"):
        fullchain += "\n"
    if not key.endswith("\n"):
        key += "\n"
    return f"""set -eu
umask 077
c={shlex.quote(h["cert_path"])}
k={shlex.quote(h["key_path"])}
for f in "$c" "$k"; do
  if [ -e "$f" ]; then cp -p "$f" "$f.cwbak"; else touch "$f.cwnone"; fi
done
cat > "$c.cwnew" <<'CW_CERT_END'
{fullchain}CW_CERT_END
cat > "$k.cwnew" <<'CW_KEY_END'
{key}CW_KEY_END
for f in "$c" "$k"; do
  if [ -e "$f" ]; then
    chmod --reference="$f" "$f.cwnew" 2>/dev/null || true
    chown --reference="$f" "$f.cwnew" 2>/dev/null || true
  fi
  mv "$f.cwnew" "$f"
done
if ( {h["test_cmd"]} ) </dev/null 2>&1 && ( {h["reload_cmd"]} ) </dev/null 2>&1; then
  rm -f "$c.cwbak" "$k.cwbak" "$c.cwnone" "$k.cwnone"
  echo CW_OK
  exit 0
fi
for f in "$c" "$k"; do
  if [ -e "$f.cwbak" ]; then mv "$f.cwbak" "$f"; elif [ -e "$f.cwnone" ]; then rm -f "$f"; fi
  rm -f "$f.cwnone"
done
echo "CW_FAIL: nginx test or reload failed, previous files restored"
exit 1
"""


def push_ssh(h, script):
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "IdentitiesOnly=yes"]
    if h.get("ssh_key"):
        cmd += ["-i", h["ssh_key"]]
    if h.get("ssh_port"):
        cmd += ["-p", str(h["ssh_port"])]
    cmd += [f"{h['ssh_user']}@{h['host']}" if h.get("ssh_user") else h["host"], "sh -s"]
    try:
        r = subprocess.run(cmd, input=script.encode(), capture_output=True, timeout=90)
    except subprocess.TimeoutExpired:
        raise RuntimeError("ssh timed out")
    out = (r.stdout + r.stderr).decode(errors="replace")
    if r.returncode != 0 or "CW_OK" not in out:
        tail = " | ".join(out.strip().splitlines()[-4:])
        raise RuntimeError(f"ssh exit {r.returncode}: {tail}")


def run_ssh_target(target, fullchain, key, digest, state_dir, force, dry_run):
    name = target["name"]
    failed = []
    for h in ssh_hosts(target):
        label = f"{name}@{h['host']}"
        path, old = read_state(state_dir, label)
        if old == digest and not force:
            log(f"[{label}] unchanged, nothing to do")
            continue
        if dry_run:
            log(f"[{label}] dry run: would write {h['cert_path']} and {h['key_path']}, "
                f"then run `{h['test_cmd']}` and `{h['reload_cmd']}` ({'changed' if old != digest else 'forced'})")
            continue
        try:
            push_ssh(h, remote_script(h, fullchain, key))
        except Exception as exc:  # one host failing must not block the others
            failed.append(h["host"])
            log(f"[{label}] ERROR: {exc}")
            continue
        write_state(path, state_dir, digest)
        log(f"[{label}] pushed, nginx tested and reloaded OK")
    if failed:
        raise RuntimeError(f"failed on {len(failed)} host(s): {', '.join(failed)}")


def run_target(target, cfg, env, state_dir, force, dry_run):
    name = target["name"]
    p = prefix_of(target)
    cw_url = cfg.get("cert_warden_url") or env["CW_URL"]
    ttype = target.get("type", "npm")
    if ttype not in ("npm", "nginx-ssh"):
        raise RuntimeError(f"unknown type {ttype!r} (use \"npm\" or \"nginx-ssh\")")

    fullchain, key = fetch_cert_and_key(cw_url, target["cw_cert"], env[f"CW_{p}_CERT_APIKEY"], env[f"CW_{p}_KEY_APIKEY"])
    digest = hashlib.sha256(fullchain.encode()).hexdigest()
    if ttype == "nginx-ssh":
        run_ssh_target(target, fullchain, key, digest, state_dir, force, dry_run)
        return

    base = (target.get("npm_url") or env[f"NPM_{p}_URL"]).rstrip("/")
    npm_name = target.get("npm_name") or f"cw-{target['cw_cert']}"
    state_file, old = read_state(state_dir, name)

    code, body = http_json("POST", base + "/api/tokens",
                           payload={"identity": env[f"NPM_{p}_USER"], "secret": env[f"NPM_{p}_PASS"]})
    token = body.get("token")
    if not token:
        raise RuntimeError(f"NPM login failed (HTTP {code})")
    code, certs = http_json("GET", base + "/api/nginx/certificates", token)
    if code != 200 or not isinstance(certs, list):
        raise RuntimeError(f"NPM certificate list failed (HTTP {code})")
    existing = next((c for c in certs if c.get("nice_name") == npm_name), None)

    if existing and old == digest and not force:
        log(f"[{name}] unchanged, NPM cert id {existing['id']} up to date, nothing to do")
        return
    if dry_run:
        action = f"upload over NPM cert id {existing['id']}" if existing else "create NPM cert and upload"
        log(f"[{name}] dry run: would {action} ({'changed' if old != digest else 'forced'})")
        return

    if existing:
        cert_id = existing["id"]
        log(f"[{name}] updating NPM cert id {cert_id} ({npm_name})")
    else:
        code, created = http_json("POST", base + "/api/nginx/certificates", token,
                                  {"provider": "other", "nice_name": npm_name})
        if code not in (200, 201) or "id" not in created:
            raise RuntimeError(f"NPM certificate create failed (HTTP {code})")
        cert_id = created["id"]
        log(f"[{name}] created NPM cert id {cert_id} ({npm_name})")

    body, ctype = multipart({"certificate": fullchain, "certificate_key": key})
    code, raw = http("POST", f"{base}/api/nginx/certificates/{cert_id}/upload",
                     {"Authorization": "Bearer " + token, "Content-Type": ctype}, body)
    if code not in (200, 201):
        try:
            msg = json.loads(raw).get("error", {}).get("message", "")
        except ValueError:
            msg = ""
        raise RuntimeError(f"NPM upload failed (HTTP {code}) {msg}")
    write_state(state_file, state_dir, digest)
    log(f"[{name}] uploaded OK")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--only", help="only this target name")
    ap.add_argument("--force", action="store_true", help="upload even if the certificate is unchanged")
    ap.add_argument("--dry-run", action="store_true", help="show what would happen, change nothing")
    ap.add_argument("--config", default=DEFAULT_CONFIG)
    ap.add_argument("--env", default=DEFAULT_ENV)
    ap.add_argument("--state-dir", default=DEFAULT_STATE_DIR)
    args = ap.parse_args()

    with open(args.config, "rb") as fh:
        cfg = tomllib.load(fh)
    env = load_env(args.env)
    targets = cfg.get("target", [])
    if args.only:
        targets = [t for t in targets if t["name"] == args.only]
        if not targets:
            sys.exit(f"no target named {args.only!r} in {args.config}")
    failed = 0
    for t in targets:
        try:
            run_target(t, cfg, env, args.state_dir, args.force, args.dry_run)
        except Exception as exc:  # keep going so one failure does not block the other targets
            failed += 1
            log(f"[{t['name']}] ERROR: {exc}")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
